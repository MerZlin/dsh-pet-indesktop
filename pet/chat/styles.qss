QDialog#chat-window {
    background: transparent;
    color: #3a4552;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}
QFrame#phone-shell {
    background: #fbf3e9;
    color: #3a4552;
    border: none;
    border-radius: 26px;
}
QFrame#chat-title-bar {
    min-height: 76px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7f92e3, stop:0.55 #9aa8ec, stop:1 #c2ade6);
    border: none;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
}
QLabel#avatar-label {
    color: #ffffff;
    font-size: 19px;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.28);
    border: 2px solid rgba(255, 255, 255, 0.65);
    border-radius: 22px;
}
QLabel#title-label {
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
}
QLabel#subtitle-label {
    color: rgba(255, 255, 255, 0.82);
    font-size: 10px;
}
QToolButton#window-minimize-button,
QToolButton#window-close-button {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border: none;
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
    font-size: 18px;
}
QToolButton#window-minimize-button:hover {
    background: rgba(255, 255, 255, 0.28);
    color: #ffffff;
}
QToolButton#window-close-button:hover {
    background: rgba(240, 110, 118, 0.9);
    color: #ffffff;
}
QFrame#chat-context-bar {
    background: #fbf3e9;
    border: none;
    border-bottom: 1px solid #f2e4d2;
}
QLabel#status-dot {
    color: #3aa87c;
    font-size: 12px;
}
QLabel#status-dot[state="busy"] {
    color: #f0a030;
}
QLabel#status-label {
    color: #2c7d5b;
    font-size: 11px;
    font-weight: 700;
}
QLabel#provider-label,
QLabel#context-caption {
    color: #a89484;
    font-size: 11px;
}
QToolButton#follow-pet-button {
    min-height: 26px;
    padding: 0 10px;
    border: none;
    border-radius: 13px;
    color: #8a7f72;
    background: transparent;
    font-size: 10px;
    font-weight: 700;
}
QToolButton#follow-pet-button:hover {
    color: @ACCENT@;
    background: #f3e9dc;
}
QToolButton#follow-pet-button:checked {
    color: #ffffff;
    background: @ACCENT@;
}
QComboBox#session-combo {
    min-height: 30px;
    padding: 0 6px;
    border: none;
    border-bottom: 1px solid #e0cfba;
    border-radius: 0px;
    color: #4a5568;
    background: transparent;
    selection-color: #3a4552;
    selection-background-color: #ffffff;
}
QComboBox#session-combo:hover,
QComboBox#session-combo:focus {
    border-bottom: 1px solid @ACCENT@;
}
QComboBox#session-combo QAbstractItemView {
    color: #3a4552;
    background: #fffdf8;
    border: none;
    selection-color: #3a4552;
    selection-background-color: #e9edfb;
}
QAbstractItemView#session-list {
    color: #3a4552;
    background: #fffdf8;
    border: none;
    outline: none;
    selection-background-color: #e9edfb;
    selection-color: #3a4552;
}
QAbstractItemView#session-list::item {
    min-height: 30px;
    padding: 7px 10px;
    color: #3a4552;
    background: #fffdf8;
}
QAbstractItemView#session-list::item:hover {
    color: #3a4552;
    background: #f2f4fd;
}
QAbstractItemView#session-list::item:selected {
    color: #3a4552;
    background: #e9edfb;
}
QComboBox#session-combo QAbstractItemView::item,
QComboBox#session-combo QAbstractItemView::item:hover,
QComboBox#session-combo QAbstractItemView::item:selected {
    color: #3a4552;
}
QToolButton#new-session-button,
QToolButton#delete-session-button,
QToolButton#clear-session-button {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    border: none;
    border-radius: 14px;
    color: #8a7f72;
    background: transparent;
}
QToolButton#new-session-button:hover,
QToolButton#delete-session-button:hover,
QToolButton#clear-session-button:hover {
    color: @ACCENT@;
    background: #f3e9dc;
}
/* 重命名按钮：文字按钮，与左下角会话列表紧邻 */
QToolButton#rename-session-button {
    min-height: 26px;
    padding: 0 10px;
    border: 1px solid #e3d5c0;
    border-radius: 13px;
    color: #7a6a55;
    background: #fdf9f1;
    font-size: 12px;
}
QToolButton#rename-session-button:hover {
    color: @ACCENT@;
    border-color: @ACCENT@;
    background: #f3e9dc;
}
QScrollArea#message-scroll {
    background: #fbf3e9;
    border: none;
    color: #3a4552;
}
QScrollArea#message-scroll QWidget#qt_scrollarea_viewport,
QWidget#message-view,
QWidget#message-timeline {
    background: #fbf3e9;
}
QLabel#empty-state {
    color: #ab9a89;
    font-size: 15px;
    line-height: 1.6;
}
QFrame#message-bubble {
    padding: 12px 15px;
    border: 1px solid rgba(80, 66, 52, 0.07);
    border-radius: 18px;
    border-top-left-radius: 7px;
    background: #ffffff;
}
QFrame#message-bubble[role="user"] {
    background: @ACCENT@;
    border-radius: 18px;
    border-top-right-radius: 7px;
}
QFrame#message-bubble[state="streaming"] {
    background: #fff4d9;
}
QFrame#message-bubble[state="error"] {
    background: #ffe9e2;
}
QFrame#message-bubble[state="stopped"] {
    background: #f1ebe1;
}
QLabel#bubble-avatar {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
}
QLabel#bubble-meta {
    color: #b3a291;
    font-size: 10px;
    font-weight: 700;
}
QFrame#message-bubble[role="user"] QLabel#bubble-meta,
QFrame#message-bubble[role="user"] QLabel#bubble-body {
    color: #ffffff;
}
QLabel#bubble-body {
    color: #3f4a5a;
    font-size: 13px;
    line-height: 1.55;
}
QLabel#bubble-status {
    color: #b17518;
    font-size: 10px;
}
QPushButton#retry-button {
    min-height: 26px;
    padding: 0 12px;
    border: none;
    border-radius: 13px;
    color: #c0534a;
    background: #ffd9d0;
}
QPushButton#retry-button:hover {
    color: #ffffff;
    background: #e08070;
}
QFrame#chat-composer {
    background: #fbf3e9;
    border: none;
    border-top: 1px solid #f2e4d2;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
}
QPlainTextEdit#chat-input {
    padding: 11px 15px;
    border: 1px solid #eadfcd;
    border-radius: 22px;
    color: #3f4a5a;
    background: #ffffff;
    selection-background-color: #c9d3f5;
}
QPlainTextEdit#chat-input:focus {
    border: 2px solid @ACCENT@;
}
QLabel#composer-hint {
    color: #ab9a89;
    font-size: 10px;
}
QPushButton#send-button {
    min-width: 64px;
    min-height: 40px;
    padding: 0 18px;
    border: none;
    border-radius: 20px;
    color: #ffffff;
    background: @ACCENT@;
    font-weight: 800;
    font-size: 13px;
}
QPushButton#send-button:hover {
    background: #6b7fd3;
}
QPushButton#send-button:disabled {
    color: #b8ab9d;
    background: #ece3d6;
}
QPushButton#send-button[busy="true"] {
    background: #e58b2b;
}
QScrollBar:vertical {
    width: 8px;
    margin: 4px 2px 4px 0;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: 4px;
    background: #e0d0bc;
}
QScrollBar::handle:vertical:hover {
    background: #c9b49c;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
