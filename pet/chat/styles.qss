QDialog#chat-window {
    background: #f4f6fa; color: #20242b; font-size: 13px;
    font-family: "SF Pro Text", ".AppleSystemUIFont", "PingFang SC", "Segoe UI", sans-serif;
}
QFrame#phone-shell { background: #ffffff; border: 1px solid #d9dde5; border-radius: 16px; }

QFrame#deepseek-sidebar {
    background: #f5f7fb; border: none; border-right: 1px solid #e5e8ef;
    border-top-left-radius: 15px; border-bottom-left-radius: 15px;
}
QLabel#avatar-label { color: #ffffff; font-size: 13px; font-weight: 700; }
QLabel#brand-label { color: #2868e8; font-size: 17px; font-weight: 700; }
QPushButton#new-conversation-button {
    min-height: 38px; border: 1px solid #e0e4eb; border-radius: 19px;
    background: #ffffff; color: #20242b; font-size: 13px; font-weight: 600;
}
QPushButton#new-conversation-button:hover { background: #eef4ff; border-color: #cbd9f7; color: #2868e8; }
QLabel#session-section-title { color: #969da9; font-size: 11px; padding: 8px 5px 2px 5px; }
QListWidget#session-list {
    background: transparent; color: #333841; border: none; outline: none; padding: 0;
}
QListWidget#session-list::item { min-height: 34px; padding: 0 10px; border-radius: 9px; }
QListWidget#session-list::item:hover { background: #edf1f7; }
QListWidget#session-list::item:selected { background: #e5edff; color: #2868e8; }
QFrame#sidebar-footer { background: #ffffff; border: 1px solid #e1e4ea; border-radius: 10px; }
QLabel#status-dot { color: #28a56b; font-size: 10px; }
QLabel#status-dot[state="busy"] { color: #dc8a24; }
QLabel#status-label { color: #3f735e; font-size: 10px; font-weight: 600; }
QLabel#provider-label { color: #858c97; font-size: 10px; }
QToolButton#follow-pet-button, QToolButton#delete-session-button, QToolButton#clear-session-button {
    min-height: 28px; border: 1px solid #d8dce3; border-radius: 8px; background: #ffffff; color: #555b65;
}
QToolButton#follow-pet-button:hover, QToolButton#delete-session-button:hover,
QToolButton#clear-session-button:hover { background: #eef2f7; }
QToolButton#follow-pet-button:checked { color: #ffffff; background: @ACCENT@; border-color: @ACCENT@; }

QFrame#chat-main { background: #ffffff; border: none; border-top-right-radius: 15px; border-bottom-right-radius: 15px; }
QFrame#chat-main-header { min-height: 58px; background: #ffffff; border: none; border-bottom: 1px solid #edf0f4; border-top-right-radius: 15px; }
QLabel#title-label { color: #242830; font-size: 14px; font-weight: 600; }
QLabel#subtitle-label { color: #6685cf; font-size: 10px; }
QToolButton#window-minimize-button, QToolButton#window-close-button {
    min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px;
    border: none; border-radius: 8px; background: transparent;
}
QToolButton#window-minimize-button:hover { background: #f0f2f5; }
QToolButton#window-close-button:hover { background: #fae4e4; }

QScrollArea#message-scroll, QScrollArea#message-scroll QWidget#qt_scrollarea_viewport,
QWidget#message-view, QWidget#message-timeline { background: #ffffff; border: none; }
QLabel#empty-state { color: #8f96a2; font-size: 14px; }
QFrame#message-bubble { padding: 5px 7px; border: none; border-radius: 13px; background: transparent; }
QFrame#message-bubble[role="user"] { padding: 8px 11px; background: #edf4ff; }
QFrame#message-bubble[state="streaming"] { background: #fff9ed; }
QFrame#message-bubble[state="error"] { background: #fff2f1; }
QFrame#message-bubble[state="stopped"] { background: #f5f6f8; }
QLabel#bubble-avatar { color: #ffffff; font-size: 11px; font-weight: 700; }
QLabel#bubble-meta { color: #4f5661; font-size: 11px; font-weight: 600; }
QLabel#bubble-body { color: #252a32; font-size: 13px; }
QLabel#bubble-status { color: #a66b16; font-size: 10px; }
QPushButton#retry-button { min-height: 25px; padding: 0 10px; border: 1px solid #d7dbe2; border-radius: 7px; background: #ffffff; }
QPushButton#retry-button:hover { background: #f0f2f5; }

QFrame#floating-composer { background: #ffffff; border: none; }
QFrame#chat-composer { background: #ffffff; border: 1px solid #d8dce4; border-radius: 15px; }
QPlainTextEdit#chat-input {
    min-height: 68px; padding: 11px 13px; color: #252a32; background: #ffffff;
    border: none; border-bottom: 1px solid #eef0f4; border-radius: 13px; selection-background-color: @ACCENT@;
}
QPlainTextEdit#chat-input:focus { border: none; border-bottom: 1px solid #cdd9f7; }
QLabel#composer-hint { color: #959ca7; font-size: 10px; padding-left: 10px; }
QPushButton#send-button {
    min-height: 32px; min-width: 68px; padding: 0 14px; border: none; border-radius: 16px;
    color: #ffffff; background: @ACCENT@; font-weight: 600;
}
QPushButton#send-button:hover { background: #286fda; }
QPushButton#send-button:disabled { color: #ffffff; background: #bdcaf0; }
QPushButton#send-button[busy="true"] { background: #d88932; }
QScrollBar:vertical { width: 8px; margin: 3px 1px; background: transparent; }
QScrollBar::handle:vertical { min-height: 28px; border-radius: 4px; background: #c8ccd3; }
QScrollBar::handle:vertical:hover { background: #aeb3bc; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
