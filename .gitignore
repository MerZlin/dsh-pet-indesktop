# Python
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# 运行时产物
tmp_appdata/
tests/_tmp_*/

# 素材：只提交 assets/characters（角色动画），其他 assets 内容不入库
assets/*
!assets/characters/
!assets/characters/**
assets/thumb/
assets/videos/
assets/animations/
assets/prompt/

# 点击音效（内置合成 click.wav，随包分发；用户可自定义覆盖）
!assets/sounds/
!assets/sounds/**

# 彩蛋弹窗图片池（fun_image_popup 随机取图，随包分发）
!assets/big_blue_fat_fish/
!assets/big_blue_fat_fish/**

# Windows 安装包图标（本地生成，入库保证克隆后可构建）
!assets/icon.ico

# PyInstaller 构建产物
build/
dist/
*.spec

# 项目记忆文档随仓库维护；仅保留临时规划目录不入库。
_plan/
# onedir build artifacts
dist-onedir/
build-onedir/

# 构建注入的变体标识（由 scripts/build_onedir.ps1 生成）
packaging/build_variant.py

# 本地实验目录（含嵌套 git 仓库，不入库）
.research/

# 聊天背景主题壁纸（聊天背景功能随包分发）
!assets/chat/
!assets/chat/**

# 全局忽略 macOS 元数据（置于所有白名单之后，防止被 !** 反向放行）
**/.DS_Store
.serena/
.scratch/

# Node 依赖树：桥接插件为零依赖红线，本地 pnpm install 残留不许入库——
# 否则原地 import 门禁蹭到它假绿，且 PyInstaller --add-data 会把 junction 垃圾带进产物
node_modules/
